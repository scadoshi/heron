# Runs on Ubuntu 26.04 as written. Before enabling a changed copy, run
#
#   systemd-analyze verify /etc/systemd/system/heron.service
#
# Setup is in context/operations/deploy.md.

[Unit]
Description=heron, GitHub stats for scottyfermo.com
Documentation=https://github.com/scadoshi/heron
Wants=network-online.target
After=network-online.target
# With CACHE_BACKEND=steller or layered, steller starts first. Comment both out
# under CACHE_BACKEND=memory. Wants, not Requires: under layered the server runs
# without it.
Wants=steller.service
After=steller.service

[Service]
Type=simple
User=heron
Group=heron
EnvironmentFile=/etc/heron/heron.env
ExecStart=/usr/local/bin/heron

# The exit code is non-zero on any startup failure.
Restart=on-failure
RestartSec=5

# SIGTERM stops accepting and drains requests in flight.
KillSignal=SIGTERM
TimeoutStopSec=30

# The memory cache holds one snapshot per configured repository. A counts
# measurement is the peak: its tarball and checkout go to disk under
# CacheDirectory, not /tmp: PrivateTmp's /tmp is RAM charged to this limit.
MemoryMax=128M
MemoryHigh=96M
TasksMax=256

# Logs go to stdout and nowhere else. The one writable path is
# /var/cache/heron, scratch space for counts measurements (MEASURE_DIR).
CacheDirectory=heron
Environment=MEASURE_DIR=/var/cache/heron/measure
StandardInput=null
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# IPv4 and IPv6 for GitHub, UNIX for journald.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
