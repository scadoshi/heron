# Copy to .env for local runs. Nothing here is secret.

# Required.
BIND_ADDRESS=127.0.0.1:3100
ALLOWED_ORIGINS=https://scottyfermo.com,http://localhost:8080
GITHUB_REPOS=scadoshi/steller,scadoshi/chickadee,scadoshi/zwipe

# Optional. Without a token GitHub allows 60 requests an hour per IP.
# GITHUB_TOKEN=
# GITHUB_API_BASE=https://api.github.com

# memory, steller, or layered (steller first, memory behind it).
CACHE_BACKEND=memory
# Required when CACHE_BACKEND is steller or layered. Loopback only.
# STELLER_ADDRESS=127.0.0.1:3000

# How long a snapshot counts as fresh, and how long the cache keeps it.
STATS_FRESH_SECS=900
STATS_RETAIN_SECS=604800

# Source counts: how often to look for repositories pushed to since they were
# measured, how long the cache keeps a measurement, and where tarballs are
# unpacked while being counted (defaults to heron-measure under the temp dir).
COUNTS_SWEEP_SECS=300
COUNTS_RETAIN_SECS=604800
# MEASURE_DIR=/tmp/heron-measure

RUST_LOG=info
